# Generate a strong key before deployment, for example:
# head -c 48 /dev/urandom | base64 | tr -d '\n'
# openssl rand -hex 48
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Outbound proxy configuration (optional)
# HTTP_PROXY=http://proxy.company.local:8080
# HTTPS_PROXY=http://proxy.company.local:8080
# NO_PROXY=localhost,127.0.0.1,postgres,redis,api,worker,scheduler
# http_proxy=http://proxy.company.local:8080
# https_proxy=http://proxy.company.local:8080
# no_proxy=localhost,127.0.0.1,postgres,redis,api,worker,scheduler

# DNS tuning for corporate/internal resolver chains (optional)
DNS_NAMESERVERS=1.1.1.1,8.8.8.8
DNS_PRIVATE_NAMESERVERS=
DNS_PUBLIC_NAMESERVERS=1.1.1.1,8.8.8.8
DNS_LIFETIME_SECONDS=8
DNS_TIMEOUT_SECONDS=2
DNS_ATTEMPTS=1
DNS_USE_SEARCH=true
WHOIS_SKIP_SUFFIXES=.internal,.local,.corp,.lan,.home,localhost

DKIM_MAX_QUERIES=80
DKIM_MAX_PARALLEL=8
DKIM_INCLUDE_DEFAULT_SELECTORS=true
DKIM_EARLY_STOP_RECORDS=6
